#!/usr/bin/env bash
#PBS -P <PROJECT_CODE>
#PBS -q gpuvolta
#PBS -l walltime=00:30:00
#PBS -l mem=16GB
#PBS -l ncpus=4
#PBS -l ngpus=1
#PBS -l storage=gdata/<PROJECT_CODE>+scratch/<PROJECT_CODE>
#PBS -j oe
#PBS -N ben_s2_loader_check
# Template; see nci/README_NCI.md. Required (qsub -v): GLUE_ROOT, SPLIT_DIR, DATA_ROOT.
# Not tested on Gadi in this revision.

set -euo pipefail
: "${GLUE_ROOT:?set GLUE_ROOT via qsub -v}"
: "${SPLIT_DIR:?set SPLIT_DIR via qsub -v}"
: "${DATA_ROOT:?set DATA_ROOT via qsub -v}"
BATCH_SIZE="${BATCH_SIZE:-8}"
VENV="${VENV:-${GLUE_ROOT}/.venvs/Glue}"

cd "${GLUE_ROOT}"
module purge
module load "${TORCH_MODULE:-pytorch/1.10.0}"
# shellcheck disable=SC1091
source "${VENV}/bin/activate"

python -m src.data.check_ben_s2_loader \
  --split_dir "${SPLIT_DIR}" \
  --data_root "${DATA_ROOT}" \
  --batch_size "${BATCH_SIZE}"
