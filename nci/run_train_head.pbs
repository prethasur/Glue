#!/usr/bin/env bash
#PBS -P <PROJECT_CODE>
#PBS -q gpuvolta
#PBS -l walltime=04:00:00
#PBS -l mem=64GB
#PBS -l ncpus=8
#PBS -l ngpus=1
#PBS -l storage=gdata/<PROJECT_CODE>+scratch/<PROJECT_CODE>
#PBS -j oe
#PBS -N ben_s2_head_only
# Output goes to <job name>.o<job id> in the submission directory. (A '-o .../$PBS_JOBID.log'
# directive is not variable-expanded by PBS, so every run would overwrite one file.)
# Template: placeholders in the directives above must be replaced or overridden on the qsub
# command line. See nci/README_NCI.md. Not tested on Gadi in this revision.

MODE=head_only
LR="${LR:-0.001}"
export MODE LR
exec bash "${GLUE_ROOT:?set GLUE_ROOT via qsub -v}/nci/train_common.sh"
